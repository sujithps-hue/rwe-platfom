# Copy to `.env` in this directory for local docker-compose use. Never commit real secrets here —
# in any real deployment these come from a secrets manager / the regional Terraform stack's outputs.

JWT_SECRET=dev-only-insecure-secret-change-me
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Example FHIR connector credential, referenced by a connector's `credentialSecretId` (see
# apps/api/src/connectors/secret-resolver.ts — dev-only env-var-backed resolver).
FHIR_DEMO_CLIENT_SECRET=
