{
  "name": "rwe-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Pluggable, multi-tenant real-world-evidence / EHR analytics platform (NeuroBlu-style) with region-aware compliance (HIPAA, GDPR, UAE PDPL, PDPA/PIPL, and more).",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
