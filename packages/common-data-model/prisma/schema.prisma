// Control-plane schema: tenancy, auth, compliance, and billing tables.
// These live in one shared Postgres database and rely on Row-Level Security
// (see rls_policies.sql) for tenant isolation, because they are cheap,
// low-volume, and must be joinable for platform-operator reporting.
//
// Clinical data (the OMOP-CDM-inspired tables: person, visit_occurrence,
// condition_occurrence, drug_exposure, measurement, observation,
// clinical_note, nlp_extracted_concept) is NOT modeled here — it is
// provisioned per tenant into its own Postgres schema from
// tenant_schema_template.sql, so a tenant's clinical data has hard
// namespace isolation in addition to RLS. See docs/MULTI_TENANCY.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Jurisdiction {
  US
  EU
  UK
  AE
  SA
  SG
  CN
  IN
  GLOBAL
}

enum IsolationTier {
  shared_schema
  dedicated_instance
}

enum TenantStatus {
  provisioning
  active
  suspended
  offboarding
  purged
}

model Tenant {
  id             String        @id @default(uuid())
  name           String
  slug           String        @unique
  homeRegion     String // e.g. "us-east", "eu-central", "me-uae", "ap-southeast"
  jurisdictions  Jurisdiction[]
  isolationTier  IsolationTier @default(shared_schema)
  schemaName     String        @unique // e.g. "tenant_acme" — the Postgres schema holding this tenant's CDM tables
  status         TenantStatus  @default(provisioning)
  parentTenantId String? // set for a sub-tenant of a reseller/"platform" tier tenant
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  users          User[]
  consentRecords ConsentRecord[]
  auditLogs      AuditLog[]
  dsarRequests   DsarRequestRecord[]
  connectors     ConnectorConfigRecord[]
  subscriptions  Subscription[]
  usageRecords   UsageRecord[]

  @@map("tenant")
}

enum RoleName {
  platform_admin
  tenant_admin
  clinician
  data_analyst
  auditor
  patient
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  email        String
  role         RoleName
  ssoSubjectId String?
  createdAt    DateTime @default(now())

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("app_user")
}

model ConsentRecord {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  dataSubjectId String
  purpose      String
  type         String // ConsentType: opt_in | notice_and_opt_out | granular_purpose
  granted      Boolean
  grantedAt    DateTime?
  revokedAt    DateTime?
  method       String

  @@index([tenantId, dataSubjectId, purpose])
  @@map("consent_record")
}

// Append-only: the API's DB role is granted INSERT + SELECT only on this table (no UPDATE/DELETE),
// enforced in rls_policies.sql, so the audit trail stays tamper-evident.
model AuditLog {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  actorId      String
  actorRole    String
  action       String
  jurisdiction Jurisdiction
  resourceType String
  resourceId   String?
  occurredAt   DateTime @default(now())
  metadata     Json

  @@index([tenantId, occurredAt])
  @@map("audit_log")
}

model DsarRequestRecord {
  id            String    @id @default(uuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  dataSubjectId String
  type          String // access | rectification | erasure | portability | restriction
  requestedAt   DateTime  @default(now())
  dueBy         DateTime
  fulfilledAt   DateTime?
  status        String // received | in_progress | fulfilled | rejected

  @@index([tenantId, status])
  @@map("dsar_request")
}

model ConnectorConfigRecord {
  id                 String   @id @default(uuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id])
  connectorType      String // e.g. "fhir-r4", "hl7v2-file", "csv-file"
  displayName        String
  credentialSecretId String // reference into a secrets manager/KMS-wrapped credential store, never a raw secret
  config             Json // non-secret configuration (base URL, resource types to sync, schedule, etc.)
  lastSyncCursor     String?
  lastSyncedAt       DateTime?
  lastSyncStatus     String? // ok | error | never_run
  consecutiveErrors  Int      @default(0)
  createdAt          DateTime @default(now())

  @@index([tenantId])
  @@map("connector_config")
}

model SubscriptionPlan {
  id                String   @id @default(uuid())
  code              String   @unique // starter | growth | enterprise | platform
  name              String
  includedAllowances Json
  overageRates      Json
  monthlyPriceCents Int?
  createdAt         DateTime @default(now())

  subscriptions Subscription[]

  @@map("subscription_plan")
}

model Subscription {
  id                    String   @id @default(uuid())
  tenantId              String
  tenant                Tenant   @relation(fields: [tenantId], references: [id])
  planId                String
  plan                  SubscriptionPlan @relation(fields: [planId], references: [id])
  billingProviderRef    String? // e.g. Stripe subscription id
  status                String // trialing | active | past_due | canceled
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime

  @@index([tenantId])
  @@map("subscription")
}

model UsageRecord {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  meter      String // records_ingested | active_seats | cohort_queries | api_calls | storage_gb_month
  quantity   Float
  periodStart DateTime
  periodEnd   DateTime
  reportedAt DateTime @default(now())

  @@index([tenantId, meter, periodStart])
  @@map("usage_record")
}
